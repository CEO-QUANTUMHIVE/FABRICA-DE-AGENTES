# ─────────────────────────────────────────────────────────────
# SECRETOS — el repositorio es PÚBLICO. Nada de esto sube nunca.
# ─────────────────────────────────────────────────────────────
apis/
*.key
*.pem
.env
.env.*
!.env.example
secrets/
credentials/
*api*.txt
*token*.txt
# binario de livekit-server.exe descargado a mano, no se versiona
scripts/livekit/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.ruff_cache/
.mypy_cache/
dist/
build/

# Node / frontend
node_modules/
.next/
.turbo/
frontend/**/dist/

# Audio generado y cache
*.wav
*.mp3
*.ogg
*.opus
cache/
audio_cache/

# Las muestras de voz NO se versionan. El repositorio es publico y un wav
# limpio de la voz de una persona alcanza para clonarla. Cada quien deja
# su propia grabacion local en tests/fixtures/; los smoke tests la saltean
# si no esta. Ver §17 y §19 del contexto maestro: la clonacion de voz
# requiere autorizacion explicita.
tests/fixtures/*.wav

# Modelos y pesos
*.pt
*.pth
*.safetensors
*.onnx
models/

# Sistema operativo y editores
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp

# Logs y temporales
*.log
logs/
tmp/
.coverage
htmlcov/
