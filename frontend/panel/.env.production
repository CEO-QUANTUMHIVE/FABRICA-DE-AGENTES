# Configuracion de los builds de produccion del panel.
#
# Va versionado a proposito: acá solo hay URLs publicas, y tenerlas en el repo
# es lo que evita que un build salga apuntando a un host que no existe. Ya
# pasó: el bundle publicado tenía VITE_API_URL=http://localhost:9999 y nadie
# podía entrar. vite.config.js ahora rechaza ese build.
#
# La clave publishable NO va acá: el repositorio es publico y la regla del
# proyecto es que no entra ninguna clave, aunque esta sea de las que viajan al
# navegador. Se pasa por entorno al compilar:
#
#   VITE_SUPABASE_ANON_KEY=sb_publishable_... npm run build
#
# Si falta, el build falla en vez de generar un bundle roto.

VITE_API_URL=https://voz.quantumhive.com.ar
VITE_SUPABASE_URL=https://bcexirhurfigrehfarol.supabase.co
