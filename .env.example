# QuantumHive Voice Engine — plantilla de entorno
#
# Copiar a .env y completar. El archivo .env está en .gitignore y NUNCA se sube:
# este repositorio es PÚBLICO.
#
# Ninguna de estas claves puede llegar al navegador. El frontend recibe
# únicamente un token temporal de LiveKit emitido por nuestro backend.

# ── LiveKit — SELF-HOSTED (no usamos LiveKit Cloud) ────────
# Desarrollo:  livekit-server --dev en la máquina local.
#              URL ws://localhost:7880 y las credenciales de dev.
# Producción:  el mismo binario en un VPS propio, con TLS (wss://).
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ── PLAN COMERCIAL — que motor de conversacion usa este tenant ──
#   pipeline  basico    Groq + Fish. Texto en el medio.   ~USD 0,013/min
#   gemini    medio     Gemini Live, voz a voz.           ~USD 0,012/min
#   openai    premium   OpenAI Realtime, voz a voz.       ~USD 0,016/min (mini)
MOTOR=pipeline

# ── Plan medio · Gemini Live ───────────────────────────────
# Con GCP_PROJECT va por Vertex AI y consume creditos de Google Cloud.
# Con GOOGLE_API_KEY va por pago por uso, contra tarjeta.
GCP_PROJECT=
GCP_LOCATION=us-east4
GOOGLE_API_KEY=
# OJO: Vertex AI usa nombres de modelo distintos que ai.google.dev.
GEMINI_MODEL=gemini-live-2.5-flash-native-audio
GEMINI_VOICE=Puck
GEMINI_TEMPERATURE=0.8

# ── Plan premium · OpenAI Realtime ─────────────────────────
# Con AZURE_OPENAI_ENDPOINT consume creditos de Azure.
# Con OPENAI_API_KEY va por pago por uso, contra tarjeta.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_KEY=
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_VOICE=alloy

# ── Groq — STT y LLM ───────────────────────────────────────
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
GROQ_LLM_MODEL=openai/gpt-oss-20b
# Pista de vocabulario para Whisper. Vacio = sin pista.
# Sin esto la marca se transcribe como "quantum high".
STT_PROMPT=

# ── Fish Audio — TTS ───────────────────────────────────────
FISH_API_KEY=
# s2.1-pro es el pago: devuelve HTTP 402 si la cuenta no tiene credito.
# s2.1-pro-free es gratuito y funciona sin credito, hasta el 31/08/2026.
FISH_MODEL=s2.1-pro
FISH_LATENCY_MODE=low
# Ritmo del habla. A 1.0 suena pausado y robotico entre palabras.
# 1.12 validado a oido como el ritmo natural.
FISH_SPEED=1.25
# Expresividad. Mas alto = mas variado, mas bajo = mas estable.
FISH_TEMPERATURE=1.0
FISH_VOICE_ID=
IDIOMA=es

# ── Supabase — control plane ───────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Límites de gasto y abuso ───────────────────────────────
MAX_SESSION_SECONDS=240
MAX_SESSIONS_PER_IP_HOUR=20
MAX_SESSIONS_PER_DAY=300
API_PUERTO=8080

# ── Aplicación ─────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
